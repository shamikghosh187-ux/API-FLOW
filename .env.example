# Server
PORT=8787
NODE_ENV=development
# Set a long random value before exposing this server publicly.
GATEWAY_API_KEY=replace-with-a-long-random-client-key
REQUEST_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576

# Dedicated API FLOW Supabase project (server-only secret key; never use a NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://tzgojhkkosrbfybecnjj.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Provider keys can be comma-separated pools OR individual/numbered Vercel variables.
# Accepted Groq names: GROQ_API_KEYS, GROQ_API_KEY, GROQ_API_KEY_1 ... GROQ_API_KEY_20
# Accepted OpenRouter names: OPENROUTER_API_KEYS, OPENROUTER_API_KEY, OPENROUTER_API_KEY_1 ... _20
# Keep real values only in local .env or hosting-provider environment settings.
GROQ_API_KEYS=
# GROQ_API_KEY=
# GROQ_API_KEY_1=
OPENROUTER_API_KEYS=
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_1=

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=API Flow